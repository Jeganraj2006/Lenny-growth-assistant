# Application
APP_ENV=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny

# Model selection: ollama | anthropic | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Retrieval
TOP_K=10
MIN_RETRIEVAL_SCORE=0.18
MAX_HISTORY_MESSAGES=8
CORPUS_GIT_SHA=uninitialized
DEMO_MODE=true
